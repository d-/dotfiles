# fisher owns most of these directories; the tracked plugin list in
# dot_config/fish/fish_plugins is the source of truth, and
# run_onchange_after_fish-plugins.sh reconciles them on apply.
.config/fish/completions
.config/fish/conf.d
.config/fish/themes

# fish's universal-variable store: machine-local and rewritten by fish itself.
.config/fish/fish_variables

# functions/ is shared: fisher's plugin functions are ignored, but the prompt
# functions below are ours and must sync.
.config/fish/functions/_*.fish
.config/fish/functions/fisher.fish
.config/fish/functions/fzf_configure_bindings.fish
